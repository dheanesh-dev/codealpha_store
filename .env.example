# Copy this file to ".env" and adjust. The ".env" file is git-ignored.
# If DJANGO_SECRET_KEY is missing, a random key is generated automatically
# and saved in a git-ignored ".secret_key" file, so local runs work out of the box.

# DJANGO_SECRET_KEY=put-a-long-random-string-here
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
